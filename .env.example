# Solkia backend + frontend standalone production environment
MONGODB_URI=mongodb://localhost:27017/SolkiaDB
PORT=3018

# Public HTTPS URL of the domain served by this backend
FRONTEND_URL=https://solkiapilates.com
NEXTAUTH_URL=https://solkiapilates.com
NEXT_PUBLIC_APP_URL=https://solkiapilates.com

# Required by NextAuth in production. Generate a strong value on the VPS.
NEXTAUTH_SECRET=change-me

# Optional internal port used by SolkiaBack to run the Next standalone server
FRONTEND_INTERNAL_PORT=3019

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# PayPal
PAYPAL_API_CLIENT=
PAYPAL_API_SECRET=
